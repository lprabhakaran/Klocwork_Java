<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.cloudbees.compliance.plugins</groupId>
  <artifactId>zap</artifactId>
  <version>2.6.6</version>
  <name>compliance-hub-plugin-zap</name>
  <description>Compliance Engine Plugin to connect to ZAP to scan applications and return the scan results</description>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>17</java.version>
    <resilience4j-spring-boot2.version>2.0.2</resilience4j-spring-boot2.version>
    <sonar.exclusions>
      **/com/cloudbees/compliance/plugins/zap/response/model/*.java,**/com/cloudbees/compliance/plugins/zap/util/ZapUtil.java,**/com/cloudbees/compliance/plugins/zap/components/ZapScript.java,**/com/cloudbees/compliance/plugins/zap/service/*.java,**/com/cloudbees/compliance/plugins/zap/exception/*.java,**/com/cloudbees/compliance/plugins/zap/auth/model/*.java,**/com/cloudbees/compliance/plugins/zap/grpc/server/*.java,**/com/cloudbees/compliance/plugins/zap/model/*.java,**/com/cloudbees/compliance/plugins/zap/constant/*.java</sonar.exclusions>
  </properties>
  <parent>
    <groupId>com.cloudbees.compliance</groupId>
    <artifactId>compliance-parent</artifactId>
    <version>2.0.29</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>
  <dependencies>
    <!-- CloudBees Compliance -->
    <dependency>
      <groupId>com.cloudbees.compliance.plugins</groupId>
      <artifactId>service-impl</artifactId>
      <version>2.2.24</version>
    </dependency>

    <!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-validation -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>


    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.32</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.18.1</version>
    </dependency>

    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot2</artifactId>
      <version>${resilience4j-spring-boot2.version}</version>
    </dependency>
    <!-- https://mvnrepository.com/artifact/io.github.resilience4j/resilience4j-annotations -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-annotations</artifactId>
      <version>${resilience4j-spring-boot2.version}</version>
    </dependency>

    <!-- specific guava update to fix GHSA-7g45-4rm6-3mm3 -->
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>32.0.1-android</version>
		</dependency>
  </dependencies>

  <distributionManagement>
    <repository>
      <id>nexus-rel-upload</id>
      <name>Internal Releases</name>
      <url>https://artifacts.cloudbees.com/repository/maven-private-releases/</url>
    </repository>
    <snapshotRepository>
      <id>nexus-snap-upload</id>
      <name>Internal Snapshot Releases</name>
      <url>https://artifacts.cloudbees.com/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <build>
    <finalName>zap</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.7</version>
        <configuration>
          <excludes>
            <exclude>**/com/cloudbees/compliance/plugins/zap/response/model/*.class</exclude>
            <exclude>**/com/cloudbees/compliance/plugins/zap/auth/model/*.class</exclude>
            <exclude>**/com/cloudbees/compliance/plugins/zap/grpc/server/*.class</exclude>
            <exclude>**/com/cloudbees/compliance/plugins/zap/model/*.class</exclude>
            <exclude>**/com/cloudbees/compliance/plugins/zap/constant/*.class</exclude>
            <exclude>**/com/cloudbees/compliance/plugins/zap/exception/*.class</exclude>
            <exclude>**/com/cloudbees/compliance/plugins/zap/service/*.class</exclude>
            <exclude>**/com/cloudbees/compliance/plugins/zap/components/ZapScript.class</exclude>
            <exclude>**/com/cloudbees/compliance/plugins/zap/util/ZapUtil.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>versions-maven-plugin</artifactId>
        <version>2.16.0</version>
      </plugin>
    </plugins>
  </build>

</project>